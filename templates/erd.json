      "relFill": "#FFFFFF",
      "relStroke": "#000000",
      "relStrokeWidth": 1.5,
      "lineColor": "#000000",
      "lineWidth": 1,
      "textColor": "#000000",
      "bgColor": "#FFFFFF"
